# Local development only. Copy this file to .env and replace every password.
# Never commit .env, passwords, private keys or real tokens.

COMPOSE_PROJECT_NAME=labsentinel
APP_ENV=development

GATEWAY_PORT=8080
KEYCLOAK_PORT=8081
FRONTEND_PORT=5173

POSTGRES_USER=labsentinel
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=labsentinel

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=labsentinel
KEYCLOAK_DB_PASSWORD=change-this-local-password

VITE_API_BASE_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=labsentinel
VITE_KEYCLOAK_CLIENT_ID=labsentinel-web
