# Local development only. Copy this file to .env and replace every password.
# Never commit .env, passwords, private keys or real tokens.

COMPOSE_PROJECT_NAME=labsentinel
APP_ENV=development

GATEWAY_PORT=8080
KEYCLOAK_PORT=8081
FRONTEND_PORT=5173

POSTGRES_USER=labsentinel
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=labsentinel

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-password

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=labsentinel
KEYCLOAK_DB_PASSWORD=change-this-local-password

VITE_API_BASE_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=labsentinel
VITE_KEYCLOAK_CLIENT_ID=labsentinel-web
# Mantener en false hasta terminar la configuración del realm y de sus usuarios.
VITE_KEYCLOAK_ENABLED=false

# Google OAuth + session cookies (auth-service)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=change-this-jwt-secret-min-32-characters
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Solo se usa para el primer admin si la tabla de usuarios está vacía.
# Después, los admins autorizan correos desde Administración de usuarios.
ADMIN_EMAILS=admin@institution.edu
# Solo desarrollo local; nunca habilitar en un despliegue compartido.
LOCAL_PASSWORD_LOGIN_ENABLED=false

# Keycloak opcional: Authorization Code + PKCE S256. No requiere ni acepta un
# secreto en el frontend; habilítelo recién después de configurar el realm.
KEYCLOAK_ENABLED=false
KEYCLOAK_URL_INTERNAL=http://keycloak:8080
KEYCLOAK_URL_PUBLIC=http://localhost:8081
KEYCLOAK_REALM=labsentinel
KEYCLOAK_CLIENT_ID=labsentinel-web
KEYCLOAK_REDIRECT_URI=http://localhost:8080/api/auth/keycloak/callback
KEYCLOAK_FRONTEND_URL=http://localhost:8080/

# Comunicación interna del simulador local; use un valor aleatorio solo en .env.
SIMULATOR_API_KEY=replace-with-a-long-random-local-simulator-key
SIMULATOR_INTERVAL_SECONDS=15
SIMULATOR_ENABLED=true
# Probabilidad por lectura (0.00005 equivale, aproximadamente, a un pico cada 7 h con 6 dispositivos y ciclo de 15 s).
SIMULATOR_RARE_PEAK_PROBABILITY=0.00005

# Avisos de alertas por SMTP. Mantener desactivado hasta disponer de una cuenta SMTP.
# Para Gmail se requiere verificación en dos pasos y una contraseña de aplicación exclusiva.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=alertas@example.com
SMTP_PASSWORD=replace-with-an-app-password-only-in-dotenv
SMTP_FROM=alertas@example.com
ALERT_EMAIL_RECIPIENTS=admin@institution.edu
