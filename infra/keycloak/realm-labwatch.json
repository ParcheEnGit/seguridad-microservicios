{
  "realm": "labwatch",
  "enabled": true,
  "displayName": "LabWatch",
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administración completa de LabWatch" },
      {
        "name": "lector",
        "description": "Consulta autorizada y creación de tickets no críticos"
      }
    ]
  },
  "clients": [
    {
      "clientId": "labwatch-web",
      "name": "LabWatch Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:8080", "http://localhost:5173"]
    },
    {
      "clientId": "labwatch-simulator",
      "name": "LabWatch Device Simulator",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
